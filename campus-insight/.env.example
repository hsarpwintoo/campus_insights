VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Required only for live lecturer and availability data from the partner platform.
# Leave blank to use the app's local/fallback behavior.
VITE_PARTNER_API_KEY=

# Optional: Google Gemini API key for live AI executive briefing generation
# (Set in functions/.env for Cloud Functions / Render or here for local development)
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
